model Project {
  id                  String               @id @default(cuid())
  name                String?
  githubLink          String?
  areasOfInterest     AreasOfInterest[]
  skills              Skill[]
  difficulty          Int
  githubIssues        Issue[]
  userId              String
  ProjectStakeholders ProjectStakeholder[]

  @@unique([id])
  @@index([name])
  @@map("projects")
}

model Issue {
  id        String
  url       String
  title     String
  assigned  User[]
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  state     String
  labels    Label[]
  projectId String
  status    String

  @@unique([id])
  @@index([title])
  @@map("issues")
}

model Label {
  id      String
  name    String
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId String?

  @@unique([id])
  @@index([name])
  @@map("labels")
}
