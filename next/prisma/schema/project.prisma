model Project {
  id                String              @id @default(cuid())
  name              String?
  githubLink        String?
  areasOfInterest   AreaOfInterest[]
  skills            Skill[]
  difficulty        String
  githubIssues      Issue[]
  ProjectMembership ProjectMembership[]
  isLocked          Boolean             @default(false)
  description       String?

  @@unique([id])
  @@index([name])
  @@map("projects")
}

model ProjectMembership {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId  String
  role       String
  dateJoined String

  @@unique([id])
  @@map("projectMemberships")
}

model Issue {
  id          String  @id @default(cuid())
  url         String
  title       String
  assigned    User[]
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  state       String
  labels      Label[]
  projectId   String
  status      String
  description String

  @@unique([id])
  @@index([title])
  @@map("issues")
}

model Label {
  id      String  @id @default(cuid())
  name    String
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId String?

  @@unique([id])
  @@index([name])
  @@map("labels")
}
