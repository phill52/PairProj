model Project {
  id                String               @id @default(cuid())
  name              String?
  githubLink        String?
  areasOfInterest   AreaOfInterest[]
  skills            Skill[]
  difficulty        String
  githubIssues      Issue[]
  ProjectMembership ProjectMembership[]
  isLocked          Boolean              @default(false)
  description       String?
  applications      ProjectApplication[]
  roles             Role[]

  @@unique([id])
  @@index([name])
  @@map("projects")
}

model Role {
  id         String   @id @default(cuid())
  name       String
  outerColor String
  innerColor String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId  String
  createdAt  DateTime @default(now())
  requiredSkills RoleRequiredSkill[]
  optionalSkills RoleOptionalSkill[]
  applications ProjectApplication[]

  @@unique([id])
  @@index([name])
  @@map("roles")
}

model ProjectMembership {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId  String
  role       String
  dateJoined String

  @@unique([id])
  @@map("projectMemberships")
}

model ProjectApplication {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  roleId    String
  createdAt DateTime @default(now())
  status    String   @default("pending")
  body      String

  @@unique([id])
  @@map("projectApplications")
}

model Issue {
  id          String  @id @default(cuid())
  url         String
  title       String
  assigned    User[]
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  state       String
  labels      Label[]
  projectId   String
  status      String
  description String

  @@unique([id])
  @@index([title])
  @@map("issues")
}

model Label {
  id      String  @id @default(cuid())
  name    String
  issue   Issue?  @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId String?

  @@unique([id])
  @@index([name])
  @@map("labels")
}

model RoleRequiredSkill {
  role    Role   @relation(fields: [roleId], references: [id])
  roleId  String
  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String

  @@id([roleId, skillId])
  @@map("role_required_skills")
}

model RoleOptionalSkill {
  role    Role   @relation(fields: [roleId], references: [id])
  roleId  String
  skill   Skill  @relation(fields: [skillId], references: [id])
  skillId String

  @@id([roleId, skillId])
  @@map("role_optional_skills")
}