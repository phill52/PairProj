model Account {
  id                String  @id @default(cuid())
  user_id           String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([user_id], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Session {
  id            String   @id @default(cuid())
  session_token String   @unique @map("session_token")
  user_id       String   @map("user_id")
  expires       DateTime
  user          User     @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?            @map("emailVerified")
  image                String?
  accounts             Account[]
  sessions             Session[]
  areasOfInterest      AreasOfInterest[]
  skills               SkillsOnUsers[]
  education            Education[]
  experience           Experience[]
  issue                Issue?               @relation(fields: [issueId], references: [id], onDelete: Restrict)
  issueId              String?
  projectContributions ProjectStakeholder[]

  @@unique([id])
  @@index([name])
  @@map("users")
}

model AreasOfInterest {
  id         String    @id @default(cuid())
  name       String
  users      User[]
  outerColor String
  innerColor String
  projects   Project[]

  @@unique([id])
  @@index([name])
  @@map("areasOfInterest")
}

model Skill {
  id         String          @id @default(cuid())
  name       String
  Users      SkillsOnUsers[]
  outerColor String
  innerColor String
  projects   Project[]

  @@unique([id])
  @@index([name])
  @@map("skills")
}

model SkillsOnUsers {
  user       User   @relation(fields: [userId], references: [id])
  userId     String
  skill      Skill  @relation(fields: [skillId], references: [id])
  skillId    String
  skillLevel String

  @@id([userId, skillId])
}

model Education {
  id          String @id @default(cuid())
  school      String
  level       String
  users       User[]
  date        String
  description String

  @@unique([id])
  @@index([school])
  @@map("education")
}

model Experience {
  id       String @id @default(cuid())
  employer String
  position String
  users    User[]

  @@unique([id])
  @@index([employer])
  @@map("experience")
}

model ProjectStakeholder {
  id         String  @id @default(cuid())
  user       User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectId  String
  role       Role[]
  dateJoined String

  @@unique([id])
  @@map("projectStakeholders")
}

model Role {
  id                  String               @id @default(cuid())
  name                String
  ProjectStakeholders ProjectStakeholder[]

  @@unique([id])
  @@map("role")
}
