model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                    String              @id @default(cuid())
  name                  String?
  email                 String?             @unique
  emailVerified         DateTime?           @map("email_verified")
  image                 String?
  accounts              Account[]
  sessions              Session[]
  areas_of_interest     Areas_of_Interest[]
  skills                Skill[]
  roles                 Role[]
  education             Education[]
  experience            Experience[]
  projects_owner        Project[]           @relation("owner")
  projects_collaborated Project[]           @relation("collaborator")
  issue                 Issue?              @relation(fields: [issueId], references: [id])
  issueId               String?

  @@unique([id])
  @@index([name])
  @@map("users")
}

model Areas_of_Interest {
  id          String   @id @default(cuid())
  name        String
  users       User[]
  outer_color String
  inner_color String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?

  @@unique([id])
  @@index([name])
  @@map("areas_of_interest")
}

model Role {
  id    String @id @default(cuid())
  name  String
  users User[]

  @@unique([id])
  @@index([name])
  @@map("roles")
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  users       User[]
  outer_color String
  inner_color String
  project     Project? @relation(fields: [projectId], references: [id])
  projectId   String?

  @@unique([id])
  @@index([name])
  @@map("skills")
}

model Education {
  id     String @id @default(cuid())
  school String
  level  String
  users  User[]

  @@unique([id])
  @@index([school])
  @@map("education")
}

model Experience {
  id       String @id @default(cuid())
  employer String
  position String
  users    User[]

  @@unique([id])
  @@index([employer])
  @@map("experience")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}
